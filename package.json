{
	"name": "capstone-ticket-system-prototype",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"start": "node build",
		"db:setup": "node --env-file-if-exists=.env --import tsx scripts/setup.ts",
		"db:generate": "drizzle-kit generate",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@electric-sql/pglite": "0.3.14",
		"@lucide/svelte": "1.65.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tanstack/svelte-hotkeys": "^0.18.0",
		"better-auth": "^1.7.14",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"formsnap": "^2.1.0",
		"postgres": "^3.4.7",
		"svelte": "latest",
		"svelte-sonner": "^1.2.2",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "latest",
		"drizzle-kit": "^0.31.11",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "latest",
		"tailwindcss": "^4.3.3",
		"tsx": "latest",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.2",
		"vitest": "^4.1.12"
	},
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24"
	}
}

erDiagram
  APPLICATION_ROLE o|--o{ USER : grants
  USER ||--o{ SESSION : has
  USER ||--o{ ACCOUNT : has
  USER ||--o| TWO_FACTOR : enrolls
  USER ||--o{ TICKET : requests
  USER o|--o{ TICKET : assigned_to
  USER ||--o{ TICKET_COMMENT : authors
  USER o|--o{ TICKET_EVENT : acts
  USER o|--o{ SECURITY_EVENT : acts
  CATEGORY ||--o{ TICKET : classifies
  TICKET_STATUS ||--o{ TICKET : tracks
  TICKET ||--o{ TICKET_COMMENT : contains
  TICKET ||--o{ TICKET_EVENT : records
  TICKET ||--o{ TICKET_FOLLOWER : followed_by
  USER ||--o{ TICKET_FOLLOWER : follows
  USER ||--o{ NOTIFICATION : receives
  TICKET ||--o{ NOTIFICATION : about

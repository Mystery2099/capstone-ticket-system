  USER {
    text id PK
    text email
    text role
    boolean enabled
  }
  SESSION {
    text id PK
    text userId FK
  }
  ACCOUNT {
    text id PK
    text userId FK
  }
  VERIFICATION {
    text id PK
  }
  CATEGORY {
    uuid id PK
    text name
    boolean active
  }
  TICKET_STATUS {
    text code PK
    text label
  }
  TICKET {
    uuid id PK
    bigint ticket_number
    text requester_id FK
    text assigned_to_user_id FK
    uuid category_id FK
    text status_code FK
    text priority
    text subject
  }
  TICKET_COMMENT {
    uuid id PK
    uuid ticket_id FK
    text author_id FK
    boolean is_internal
    text body
  }
  TICKET_EVENT {
    uuid id PK
    uuid ticket_id FK
    text actor_id FK
    text event_type
    jsonb details
  }

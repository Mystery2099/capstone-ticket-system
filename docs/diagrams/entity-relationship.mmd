  USER o|--o{ NOTIFICATION : acts
  APPLICATION_ROLE {
    text id PK
    text name
    jsonb permissions
  }
  USER {
    text id PK
    text email
    text role FK
    boolean banned
    boolean two_factor_enabled
  }
  SESSION {
    text id PK
    text user_id FK
  }
  ACCOUNT {
    text id PK
    text user_id FK
    text provider_id
  }
  TWO_FACTOR {
    text id PK
    text user_id FK
  }
  VERIFICATION {
    text id PK
  }
  CATEGORY {
    uuid id PK
    text name
    boolean active
  }
  TICKET_STATUS {
    text code PK
    text label
  }
  TICKET {
    uuid id PK
    bigint ticket_number
    text requester_id FK
    text assigned_to_user_id FK
    uuid category_id FK
    text status_code FK
    text priority
    text subject
    text description_format
  }
  TICKET_COMMENT {
    uuid id PK
    uuid ticket_id FK
    text author_id FK
    boolean is_internal
    text body_format
  }
  TICKET_EVENT {
    uuid id PK
    uuid ticket_id FK
    text actor_id FK
    text event_type
    jsonb details
  }
  SECURITY_EVENT {
    uuid id PK
    text actor_id FK
    text action
    text target_id
    jsonb details
  }
  TICKET_FOLLOWER {
    uuid ticket_id PK, FK
    text user_id PK, FK
  }
  NOTIFICATION {
    uuid id PK
    text recipient_id FK
    uuid ticket_id FK
    text actor_id FK
    uuid comment_id FK
    text kind
    timestamp read_at
  }

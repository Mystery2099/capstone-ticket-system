flowchart TD
    ROOT[Application] --> LOGIN[Sign in /login]
    ROOT --> APP[Authenticated workspace /app]
    APP --> LIST[Ticket lists /app/tickets]
    LIST --> MY[My Tickets view]
    LIST --> ASSIGNED[Assigned to Me view]
    LIST --> UNASSIGNED[Unassigned view]
    LIST --> ALL[All Tickets view]
    LIST --> FILTERS[Search and filters]
    LIST --> DETAIL[Ticket detail /app/tickets/id]
    LIST --> NEW[Create ticket /app/tickets/new]
    DETAIL --> REPLY[Public reply]
    DETAIL --> NOTE[Internal note: agent/admin]
    DETAIL --> STATUS[Status and assignment: agent/admin]
    DETAIL --> REOPEN[Reopen resolved: original requester]
    APP --> ADMIN[Administration /app/admin]
    ADMIN --> USERS[Manage users /app/admin/users]
    ADMIN --> CATS[Manage categories /app/admin/categories]

# Hosted PostgreSQL: use separate fields OR DATABASE_URL.
# PGHOST=YOUR-SERVER.postgres.database.azure.com
# PGUSER=YOUR-USER
# PGPORT=5432
# PGDATABASE=YOUR-DATABASE
# PGPASSWORD=""
# Separate fields enable TLS with certificate verification automatically.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Explicit DATA_DIR selects local PGlite when DATABASE_URL is absent,
# even if PGHOST exists (used to isolate test processes).
# DATA_DIR=.data/postgres
# Without hosted settings or DATA_DIR, development uses .data/postgres.
# ORIGIN=http://localhost:5173
# BETTER_AUTH_SECRET=

# Use migration credentials only when running pnpm db:migrate.
# The web process should use a separate restricted database login.
